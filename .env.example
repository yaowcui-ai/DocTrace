# Copy this file to .env and fill in the existing LightRAG service key.
# Do not use the DeepSeek or embedding provider key here.
LIGHTRAG_URL=http://127.0.0.1:9624
LIGHTRAG_API_KEY=

# DocTrace rerank experiments (loaded by app/rerank_config.py).
# Use a SiliconFlow provider key, not the LightRAG service key.
RERANK_URL=https://api.siliconflow.cn/v1/rerank
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=

# DocTrace answer generation (loaded by app/answer_config.py).
# Use the existing DeepSeek provider key, not the LightRAG or SiliconFlow key.
ANSWER_URL=https://api.deepseek.com/chat/completions
ANSWER_MODEL=deepseek-flash
ANSWER_API_KEY=

# User-selected experimental policy for /ask/optimized.
CONTEXT_MAX_CHARS=30000
CONTEXT_MIN_SCORE=0.3

# Medium HR pipeline for /ask/optimized. The legacy /ask keeps LIGHTRAG_URL.
# Uses the existing LIGHTRAG_API_KEY; the HR instance currently shares that service key.
HR_LIGHTRAG_URL=http://127.0.0.1:9624
HR_MAX_TOTAL_TOKENS=40000

# Local MySQL history storage. Set the app account password privately in .env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=doctrace
MYSQL_USER=doctrace_app
MYSQL_PASSWORD=

# Configured corpus label for question history.
HR_CORPUS_ID=gitlab_hr_v3

# Browser session policy. Local HTTP uses false; HTTPS requires true.
AUTH_ALLOWED_ORIGIN=http://127.0.0.1:8001
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=7200
