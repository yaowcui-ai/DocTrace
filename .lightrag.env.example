# Copy to .lightrag.env; never commit the populated file.
HOST=0.0.0.0
PORT=9621
WORKSPACE=gitlab_hr_v3
LIGHTRAG_API_KEY=

# OpenAI-compatible generation provider (also used for entity extraction).
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.deepseek.com/v1
LLM_BINDING_API_KEY=
LLM_MODEL=deepseek-flash

# OpenAI-compatible BGE-M3 embedding provider. Use an available model for your account.
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1
EMBEDDING_BINDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192

CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
MAX_TOTAL_TOKENS=40000
RERANK_BY_DEFAULT=false
